# PhishGuard AI Environment Configuration
FLASK_ENV=development
SECRET_KEY=dev_secret_key_phishguard_ai_2026_replace_in_production
HOST=127.0.0.1
PORT=5000

# SQLite Database Location
DATABASE_PATH=backend/database/phishguard.db

# Max request upload size (10 MB = 10485760 bytes)
MAX_CONTENT_LENGTH=10485760

# Rate Limiting
RATELIMIT_DEFAULT=120 per minute
RATELIMIT_STORAGE_URI=memory://

# Optional Tesseract OCR binary path (e.g., C:\Program Files\Tesseract-OCR\tesseract.exe on Windows)
# Leave empty if tesseract is in your system PATH
TESSERACT_CMD=

# Threat Intelligence (Optional integrations)
THREAT_INTEL_API_KEY=
